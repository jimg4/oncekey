[Unit]
Description=Butterfly Guard built-in Apple keyboard debounce
After=systemd-udevd.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/butterfly-guard daemon
Restart=on-failure
RestartSec=2
RuntimeDirectory=butterfly-guard
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
